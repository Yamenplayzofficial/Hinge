    await new Promise(res => { const step = () => { const f = (performance.now() - t0) / 1000 * P.fps; if (f >= P.length) { drawScene(g, sw, sh, sc, U.view, 0, true, opts); setTimeout(() => { rec.stop(); res(); }, 150); return; } drawScene(g, sw, sh, sc, U.view, f, true, opts); requestAnimationFrame(step); }; step(); });
    await done;
    const type = rec.mimeType || mime || 'video/webm', blob = new Blob(chunks, { type }), url = URL.createObjectURL(blob); dlgUrls.push(url);
    out.innerHTML = ''; out.append(h('video', { src: url, controls: true, loop: true, playsinline: true }),
      h('a', { class: 'btn primary', href: url, download: 'hinge-animation.' + (type.includes('mp4') ? 'mp4' : 'webm') }, 'Download video'));
  } catch (err) { status.className = 'err'; status.textContent = 'Recording failed: ' + (err.message || 'unknown error'); }
}

