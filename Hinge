<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Hinge – puppet animation studio</title>
<style>
:root{
  --paper:#E6EEEC; --panel:#FFFFFF; --panel2:#F1F6F5; --ink:#1E2B3C; --muted:#586878; --line:#CBD8D6;
  --stage:#F8FBFA; --dot:#CBD8D5; --floor:rgba(30,43,60,.55); --floor-fill:rgba(15,122,115,.09);
  --outline:#1E2B3C; --shadow:rgba(30,43,60,.22);
  --joint:#0F7A73; --on-joint:#FFFFFF; --pivot:#6B4FD8; --key:#F2B134; --danger:#B3342E;
  --row-a:#FFFFFF; --row-b:#F5F8F8; --row-sel:#D9EFEC;
  color-scheme: light;
}
@media (prefers-color-scheme: dark){
  :root{
    --paper:#142427; --panel:#1D3236; --panel2:#182A2D; --ink:#E4EEEC; --muted:#9BB2B0; --line:#32504F;
    --stage:#22393D; --dot:#35545A; --floor:rgba(228,238,236,.6); --floor-fill:rgba(63,193,182,.10);
    --outline:#0F1C1E; --shadow:rgba(0,0,0,.38);
    --joint:#3FC1B6; --on-joint:#0F1C1E; --pivot:#A998FF; --key:#F2B134; --danger:#F08A84;
    --row-a:#1D3236; --row-b:#192C2F; --row-sel:#24474A;
    color-scheme: dark;
  }
}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--paper);color:var(--ink);font:14px/1.4 ui-rounded,"SF Pro Rounded","Nunito","Varela Round","Trebuchet MS",system-ui,sans-serif;-webkit-text-size-adjust:100%}
button,input,select,textarea{font:inherit;color:inherit}
[hidden]{display:none!important}
svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}

/* ---------- controls ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:34px;padding:0 12px;border:1px solid var(--line);border-radius:9px;background:var(--panel);cursor:pointer;white-space:nowrap;touch-action:manipulation}
.btn:hover{background:var(--panel2)}
.btn:disabled{opacity:.45;cursor:default}
.btn.icon{width:34px;padding:0}
.btn.primary{background:var(--joint);border-color:var(--joint);color:var(--on-joint);font-weight:600}
.btn.primary:hover{filter:brightness(1.08)}
.btn.danger{color:var(--danger)}
.btn[aria-pressed="true"]:not(.primary){background:var(--row-sel);border-color:var(--joint)}
.btn.sm{min-height:30px;padding:0 10px;font-size:13px}
:is(button,input,select,textarea,canvas,summary):focus-visible{outline:2px solid var(--joint);outline-offset:2px}
input[type=text],input[type=number],select,textarea{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:6px 8px;min-height:34px;width:100%}
input[type=number]{font-variant-numeric:tabular-nums}
input[type=range]{width:100%;accent-color:var(--joint);margin:0}
input[type=checkbox]{accent-color:var(--joint);width:18px;height:18px;margin:0}

/* ---------- layout ---------- */
#app{height:100vh;height:100dvh;min-height:560px;display:grid;
  grid-template-columns:224px minmax(0,1fr) 272px;grid-template-rows:auto minmax(250px,1fr) 276px;
  grid-template-areas:"top top top" "parts stage insp" "tl tl tl"}
.top{grid-area:top;display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--panel);border-bottom:1px solid var(--line);position:relative;z-index:5}
.brand{display:flex;align-items:center;gap:8px;font-weight:800;font-size:18px;letter-spacing:.2px;margin-right:4px}
.brand svg{width:28px;height:28px;stroke:none}
#projName{width:170px;font-weight:600}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--panel2)}
.seg button{border:0;background:none;padding:0 14px;min-height:34px;cursor:pointer;font-weight:600;color:var(--muted)}
.seg button[aria-pressed="true"]{background:var(--ink);color:var(--panel)}
.grow{flex:1}
#fileActions{display:flex;gap:6px;align-items:center}
#menuBtn{display:none}
.dirty::after{content:"";display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--key);margin-left:2px}

.panel{background:var(--panel);display:flex;flex-direction:column;min-height:0;min-width:0}
#panelParts{grid-area:parts;border-right:1px solid var(--line)}
#panelInspector{grid-area:insp;border-left:1px solid var(--line)}
#panelTimeline{grid-area:tl;border-top:1px solid var(--line)}
.panelHead{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:10px 12px 6px}
h2{margin:0;font-size:13px;font-weight:700;color:var(--muted)}
.scroll{overflow:auto;min-height:0;flex:1}
.empty{padding:16px 12px;color:var(--muted)}

#partList{display:flex;flex-direction:column;padding:2px 6px 8px}
.partItem{display:flex;align-items:center;gap:8px;width:100%;text-align:left;border:0;background:none;padding:6px 8px;border-radius:8px;cursor:pointer;min-height:32px}
.partItem:hover{background:var(--panel2)}
.partItem[aria-pressed="true"]{background:var(--row-sel);font-weight:600}
.sw{width:14px;height:14px;border-radius:4px;border:1.5px solid var(--outline);flex:none}
.nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.partFoot{display:flex;gap:6px;padding:8px 10px;border-top:1px solid var(--line)}
.partFoot .btn{flex:1}

#stageWrap{grid-area:stage;position:relative;min-height:0;min-width:0;overflow:hidden;background:var(--stage)}
#stage{position:absolute;inset:0;width:100%;height:100%;touch-action:none;display:block;cursor:pointer}
#stage[data-tool="pan"]{cursor:grab}
#stage[data-tool="move"]{cursor:move}
#stage[data-tool="pivot"]{cursor:crosshair}
#toolbar{position:absolute;left:10px;top:10px;display:flex;flex-direction:column;gap:4px;padding:4px;background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:0 2px 8px var(--shadow)}
#toolbar .btn{border-color:transparent}
#toolbar .btn[aria-pressed="true"]{background:var(--joint);color:var(--on-joint)}
#viewbar{position:absolute;left:10px;right:10px;bottom:10px;display:flex;align-items:center;gap:6px;flex-wrap:wrap;pointer-events:none}
#viewbar>*{pointer-events:auto}
.chips{display:flex;gap:4px;padding:4px;background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:0 2px 8px var(--shadow)}
.chips .btn{border-color:transparent}
#toolHint{flex:1;min-width:160px;max-width:420px;padding:6px 10px;border-radius:10px;background:var(--panel);border:1px solid var(--line);color:var(--muted);font-size:13px;box-shadow:0 2px 8px var(--shadow)}
#guide{position:absolute;top:10px;left:64px;right:10px;max-width:400px;margin-left:auto;padding:12px 14px;background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:0 4px 14px var(--shadow)}
#guide h3{margin:0 0 4px;font-size:14px}
#guide ol{margin:0;padding-left:20px}
#guide li{margin:2px 0}
#guide .btn{margin-top:8px}
#toast{position:absolute;left:50%;top:14px;transform:translateX(-50%);padding:8px 14px;border-radius:10px;background:var(--ink);color:var(--panel);font-size:13px;opacity:0;pointer-events:none;transition:opacity .15s;max-width:90%;text-align:center}
#toast.show{opacity:1}

.field{display:block;margin:0 0 12px}
.field>span,.field>label,.lab{display:block;font-size:13px;font-weight:600;color:var(--muted);margin-bottom:4px}
.row{display:flex;align-items:center;gap:8px}
.row>input[type=number]{width:76px;flex:none}
.hint{margin:4px 0 0;font-size:12.5px;color:var(--muted)}
.inspSec{padding:0 12px}
.inspSec+.inspSec{padding-top:10px;border-top:1px solid var(--line)}
.btnrow{display:flex;gap:6px;flex-wrap:wrap}
#swatches{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.swb{width:26px;height:26px;border-radius:7px;border:2px solid var(--outline);cursor:pointer;padding:0}
.swb[aria-pressed="true"]{outline:3px solid var(--joint);outline-offset:1px}
#fColor{width:34px;height:30px;padding:2px;min-height:0}

#app[data-mode="animate"] .buildOnly{display:none!important}
#app[data-mode="build"] .animOnly{display:none!important}

/* timeline */
.tlBar{display:flex;flex-wrap:wrap;gap:6px 14px;align-items:center;padding:8px 12px;border-bottom:1px solid var(--line)}
.grp{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.mini{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--muted)}
.mini input[type=number]{width:62px;min-height:30px;padding:3px 6px}
.mini select{width:auto;min-height:30px;padding:3px 6px}
.readout{font-variant-numeric:tabular-nums;font-weight:700;min-width:96px;text-align:center}
.tlBody{display:flex;flex:1;min-height:0}
.tlNames{width:156px;flex:none;display:flex;flex-direction:column;border-right:1px solid var(--line);min-height:0}
.tlCorner{height:30px;flex:none;background:var(--panel2);border-bottom:1px solid var(--line)}
#tlNameList{overflow:hidden;flex:1;min-height:0}
.tlName{display:flex;align-items:center;gap:6px;height:26px;width:100%;border:0;background:none;text-align:left;padding:0 8px;cursor:pointer;font-size:13px}
.tlName[aria-pressed="true"]{background:var(--row-sel);font-weight:600}
.tlName .nm{flex:1}
.tlMain{flex:1;min-width:0;display:flex;flex-direction:column;min-height:0}
#rulerWrap{height:30px;flex:none;overflow:hidden;border-bottom:1px solid var(--line)}
#tlScroll{flex:1;min-height:0;overflow:auto}
#ruler,#rows{display:block;touch-action:none}
#ruler{cursor:ew-resize}
#rows{cursor:pointer}
.tlMsg{display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding:18px 16px;color:var(--muted)}
#app[data-mode="animate"] #tlBuildMsg{display:none}
#app[data-mode="build"] .tlBar,#app[data-mode="build"] .tlBody{display:none}

#mobileTabs{display:none;grid-area:tabs;background:var(--panel);border-top:1px solid var(--line)}
#mobileTabs button{flex:1;min-height:42px;border:0;background:none;font-weight:600;color:var(--muted);cursor:pointer;border-bottom:3px solid transparent}
#mobileTabs button[aria-pressed="true"]{color:var(--ink);border-bottom-color:var(--joint)}

dialog{border:1px solid var(--line);border-radius:14px;padding:0;background:var(--panel);color:var(--ink);width:min(560px,calc(100vw - 24px));max-height:calc(100dvh - 24px);box-shadow:0 12px 40px var(--shadow)}
dialog::backdrop{background:rgba(10,20,22,.5)}
.dlgHead{padding:14px 16px 4px;font-size:17px;font-weight:800;margin:0}
#dlgBody{padding:6px 16px 4px;overflow:auto;max-height:calc(100dvh - 160px)}
#dlgActions{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;padding:12px 16px 16px}
#dlgBody h3{font-size:14px;margin:14px 0 4px}
#dlgBody p{margin:4px 0}
#dlgBody ul,#dlgBody ol{margin:4px 0;padding-left:20px}
#dlgBody textarea{min-height:150px;font:12px/1.4 ui-monospace,Menlo,Consolas,monospace;resize:vertical}
#dlgBody img,#dlgBody video{max-width:100%;border-radius:10px;border:1px solid var(--line);display:block;margin:8px 0}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin:8px 0}
.charCard{display:flex;flex-direction:column;align-items:flex-start;gap:4px;text-align:left;padding:10px;border:1px solid var(--line);border-radius:12px;background:var(--panel2);cursor:pointer}
.charCard:hover{border-color:var(--joint)}
.charCard canvas{border-radius:8px;background:var(--stage);align-self:center}
.charCard span{color:var(--muted);font-size:13px}
.err{color:var(--danger);font-weight:600}
kbd{font:12px ui-monospace,Menlo,Consolas,monospace;background:var(--panel2);border:1px solid var(--line);border-radius:5px;padding:1px 5px}
dl.keys{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;margin:4px 0}
dl.keys dd{margin:0}
dl.keys dt{white-space:nowrap}

@media (max-width:860px){
  #app{grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(220px,1fr) auto 318px;grid-template-areas:"top" "stage" "tabs" "dock"}
  #panelParts,#panelInspector,#panelTimeline{grid-area:dock;display:none;border:0}
  #app[data-tab="parts"] #panelParts,#app[data-tab="insp"] #panelInspector,#app[data-tab="time"] #panelTimeline{display:flex}
  #mobileTabs{display:flex}
  #panelInspector{overflow:auto}
  .brand span{display:none}
  #projName{display:none}
  #menuBtn{display:inline-flex}
  #fileActions{display:none;position:absolute;top:100%;right:8px;flex-direction:column;align-items:stretch;padding:8px;background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:0 8px 24px var(--shadow);min-width:170px}
  #app.menuOpen #fileActions{display:flex}
  #fileActions .btn{justify-content:flex-start}
  #projNameMobile{display:block}
  .tlNames{width:104px}
  #guide{left:60px;max-width:none}
}
@media (min-width:861px){ #projNameMobile{display:none} }
@media (prefers-reduced-motion:reduce){ #toast{transition:none} }
</style>
</head>
<body>
<div id="app" data-mode="animate" data-tab="parts">

  <header class="top">
    <div class="brand">
      <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="3" y="14" width="18" height="8" rx="4" transform="rotate(-28 8 18)" fill="#0F7A73"/><rect x="11" y="13" width="18" height="8" rx="4" transform="rotate(32 22 17)" fill="#F2B134"/><circle cx="16" cy="17" r="4.2" fill="#fff" stroke="#1E2B3C" stroke-width="2"/></svg>
      <span>Hinge</span>
    </div>
    <input id="projName" type="text" maxlength="40" aria-label="Project name" value="Walker">
    <div class="seg" role="group" aria-label="Mode">
      <button id="modeBuild" type="button" aria-pressed="false">Build</button>
      <button id="modeAnimate" type="button" aria-pressed="true">Animate</button>
    </div>
    <div class="grow"></div>
    <button id="undoBtn" class="btn icon" type="button" aria-label="Undo" title="Undo (Ctrl+Z)" data-icon="undo"></button>
    <button id="redoBtn" class="btn icon" type="button" aria-label="Redo" title="Redo (Ctrl+Shift+Z)" data-icon="redo"></button>
    <button id="menuBtn" class="btn icon" type="button" aria-label="Menu" aria-expanded="false" data-icon="menu"></button>
    <div id="fileActions">
      <button id="charBtn" class="btn" type="button">Characters</button>
      <button id="saveBtn" class="btn" type="button">Save</button>
      <button id="openBtn" class="btn" type="button">Open</button>
      <button id="exportBtn" class="btn" type="button">Export</button>
      <button id="helpBtn" class="btn icon" type="button" aria-label="Help" title="Help" data-icon="help"></button>
    </div>
  </header>

  <section id="panelParts" class="panel" aria-label="Parts">
    <div class="panelHead"><h2>Parts</h2></div>
    <div class="scroll"><div id="partList"></div></div>
    <div class="partFoot buildOnly">
      <button id="addPartBtn" class="btn sm" type="button" data-icon="plus">Add part</button>
      <button id="delPartBtn" class="btn sm danger" type="button" data-icon="trash">Delete</button>
    </div>
  </section>

  <main id="stageWrap">
    <canvas id="stage" tabindex="0" data-tool="rotate" aria-label="Animation stage. Arrow keys step through frames. Square bracket keys rotate the selected part."></canvas>
    <div id="toolbar" role="group" aria-label="Tools">
      <button class="btn icon toolBtn" type="button" data-tool="rotate" aria-pressed="true" aria-label="Rotate tool" title="Rotate (R)" data-icon="rotate"></button>
      <button class="btn icon toolBtn" type="button" data-tool="pivot" aria-pressed="false" aria-label="Pivot tool" title="Pivot (P)" data-icon="pivot"></button>
      <button class="btn icon toolBtn" type="button" data-tool="move" aria-pressed="false" aria-label="Move character tool" title="Move character (M)" data-icon="move"></button>
      <button class="btn icon toolBtn" type="button" data-tool="pan" aria-pressed="false" aria-label="Pan tool" title="Pan (H)" data-icon="hand"></button>
    </div>
    <div id="guide">
      <h3>Start here</h3>
      <ol>
        <li>Press Play to watch the walk cycle.</li>
        <li>Pause, pick a joint, and drag it to change the pose.</li>
        <li>Move the playhead to another frame and pose again. Keys appear in the timeline.</li>
      </ol>
      <button id="guideClose" class="btn sm" type="button">Got it</button>
    </div>
    <div id="toast" role="status" aria-live="polite"></div>
    <div id="viewbar">
      <div id="toolHint"></div>
      <div class="chips" role="group" aria-label="View options">
        <button id="tglJoints" class="btn sm" type="button" aria-pressed="true">Joints</button>
        <button id="tglFloor" class="btn sm" type="button" aria-pressed="true">Floor</button>
        <button id="tglOnion" class="btn sm animOnly" type="button" aria-pressed="false" title="Show faint poses before and after">Onion skin</button>
        <button id="tglSnap" class="btn sm" type="button" aria-pressed="false" title="Snap rotation to 5 degrees">Snap</button>
      </div>
      <div class="chips" role="group" aria-label="Zoom">
        <button id="zoomOut" class="btn icon sm" type="button" aria-label="Zoom out" data-icon="minus"></button>
        <button id="zoomFit" class="btn icon sm" type="button" aria-label="Fit character in view" data-icon="fit"></button>
        <button id="zoomIn" class="btn icon sm" type="button" aria-label="Zoom in" data-icon="plus"></button>
      </div>
    </div>
  </main>

  <section id="panelInspector" class="panel" aria-label="Part settings">
    <div class="panelHead"><h2>Part settings</h2></div>
    <input id="projNameMobile" type="text" hidden aria-hidden="true" tabindex="-1">
    <div id="inspEmpty" class="empty">Pick a part on the stage or in the Parts list.</div>
    <div id="inspBody" class="scroll" hidden>
      <div class="inspSec">
        <div class="field"><label for="fName">Name</label><input id="fName" type="text" maxlength="24"></div>
        <div class="field">
          <label for="fAngle" id="angleLabel">Rotation</label>
          <div class="row"><input id="fAngleRange" type="range" min="-180" max="180" step="1" aria-label="Rotation slider"><input id="fAngle" type="number" step="1"><span>°</span></div>
          <p class="hint" id="angleHint"></p>
        </div>
      </div>
      <div class="inspSec buildOnly">
        <div class="lab">Pivot (the joint it turns around)</div>
        <div class="btnrow">
          <button id="pivTop" class="btn sm" type="button">Top end</button>
          <button id="pivMid" class="btn sm" type="button">Middle</button>
          <button id="pivBot" class="btn sm" type="button">Bottom end</button>
        </div>
        <p class="hint">Or use the Pivot tool and drag the purple handle on the stage.</p>
        <div class="field" style="margin-top:12px">
          <label class="row" style="margin:0"><input id="fLimit" type="checkbox"><span class="lab" style="margin:0">Limit how far this joint can bend</span></label>
          <div id="limitRow" class="row" style="margin-top:8px"><label class="mini">From <input id="fMin" type="number" step="5"></label><label class="mini">to <input id="fMax" type="number" step="5"></label></div>
        </div>
      </div>
      <div class="inspSec buildOnly">
        <div class="field"><label for="fShape">Shape</label>
          <select id="fShape"><option value="capsule">Rounded bar</option><option value="ellipse">Oval</option><option value="rect">Rectangle</option></select></div>
        <div class="field"><label for="fW">Width</label><div class="row"><input id="fWr" type="range" min="4" max="200" step="1" aria-label="Width slider"><input id="fW" type="number" min="4" max="400"></div></div>
        <div class="field"><label for="fH">Length</label><div class="row"><input id="fHr" type="range" min="4" max="200" step="1" aria-label="Length slider"><input id="fH" type="number" min="4" max="400"></div></div>
        <div class="field"><span class="lab">Color</span><div id="swatches"></div></div>
        <div class="field"><span class="lab">Layer</span><div class="btnrow"><button id="bBack" class="btn sm" type="button">Send back</button><button id="bFwd" class="btn sm" type="button">Bring forward</button></div></div>
      </div>
    </div>
  </section>

  <section id="panelTimeline" class="panel" aria-label="Timeline">
    <div id="tlBuildMsg" class="tlMsg">
      <div>You're building the puppet. Rotating a joint here sets its starting pose. Switch to Animate to add keyframes and play it back.</div>
      <button id="goAnimate" class="btn primary" type="button">Start animating</button>
    </div>
    <div class="tlBar">
      <div class="grp">
        <button id="bStart" class="btn icon" type="button" aria-label="Go to first frame" title="First frame" data-icon="skipStart"></button>
        <button id="bPrev" class="btn icon" type="button" aria-label="Previous frame" title="Previous frame (Left arrow)" data-icon="prev"></button>
        <button id="bPlay" class="btn icon primary" type="button" aria-label="Play" title="Play / pause (Space)" data-icon="play"></button>
        <button id="bNext" class="btn icon" type="button" aria-label="Next frame" title="Next frame (Right arrow)" data-icon="next"></button>
        <button id="bLoop" class="btn icon" type="button" aria-label="Loop" aria-pressed="true" title="Loop playback" data-icon="loop"></button>
        <output id="frameOut" class="readout" aria-live="off">Frame 0 of 24</output>
      </div>
      <div class="grp">
        <label class="mini">Speed <input id="fps" type="number" min="1" max="60"> frames/sec</label>
        <label class="mini">Length <input id="len" type="number" min="2" max="240"> frames</label>
      </div>
      <div class="grp">
        <button id="bKeyAll" class="btn sm" type="button" title="Add a key for every part at this frame (Shift+K)">Key all</button>
        <button id="bCopy" class="btn sm" type="button">Copy pose</button>
        <button id="bPaste" class="btn sm" type="button">Paste pose</button>
        <button id="bSwap" class="btn sm" type="button" title="Swap the pose of left and right parts at this frame">Swap sides</button>
      </div>
      <div class="grp">
        <label class="mini">Easing
          <select id="ease" aria-label="Easing for the selected key">
            <option value="linear">Even</option><option value="smooth">Smooth</option><option value="in">Slow start</option>
            <option value="out">Slow finish</option><option value="back">Overshoot</option><option value="bounce">Bounce</option><option value="hold">Hold</option>
          </select></label>
