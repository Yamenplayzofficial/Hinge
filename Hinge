/* ---------- update orchestration ---------- */
let raf = 0;
function requestDraw() { if (raf) return; raf = requestAnimationFrame(() => { raf = 0; drawStage(); drawTimeline(); }); }
function updateAll(light) {
  if (!light) { renderParts(); renderNames(); }
  refreshInspector(); syncEase(); updateTransport(); updateHint(); updateUndo();
  requestDraw();
}
new ResizeObserver(() => requestDraw()).observe($('#stageWrap'));
new ResizeObserver(() => requestDraw()).observe(tlScroll);
window.addEventListener('resize', requestDraw);

/* ---------- start ---------- */
P = makePerson(); reindex(); U.sel = rootPart().id;
commit(); U.dirty = false;
$('#projName').value = P.name;
updateAll();
requestAnimationFrame(() => { fitView(); requestDraw(); if (!reduceMotion) play(); });
})();
